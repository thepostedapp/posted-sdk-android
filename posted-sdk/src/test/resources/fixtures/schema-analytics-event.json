{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "AnalyticsEventRequest — analytics/event endpoint. data is allowed but may be any type including null.",
  "type": "object",
  "properties": {
    "event_name": { "type": "string" },
    "data": {},
    "timestamp": { "type": "string" },
    "platform": { "type": "string", "enum": ["ios", "android"] },
    "device_id": { "type": "string" }
  },
  "required": ["event_name", "timestamp", "platform", "device_id"],
  "additionalProperties": false
}
