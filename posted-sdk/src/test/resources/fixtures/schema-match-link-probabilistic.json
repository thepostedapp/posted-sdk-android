{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "ProbabilisticFingerprint — match-link probabilistic branch (device fingerprint, no clickId).",
  "type": "object",
  "properties": {
    "platform": { "type": "string", "enum": ["ios", "android"] },
    "model": { "type": "string" },
    "manufacturer": { "type": "string" },
    "systemVersion": { "type": "string" },
    "screenWidth": { "type": "number" },
    "screenHeight": { "type": "number" },
    "scale": { "type": "number" },
    "locale": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "languageTag": { "type": "string" }
        },
        "required": ["languageTag"],
        "additionalProperties": false
      }
    },
    "timezone": { "type": ["string", "null"] },
    "userAgent": { "type": ["string", "null"] },
    "timestamp": { "type": "integer" },
    "pastedLink": { "type": ["string", "null"] }
  },
  "required": ["platform", "model", "manufacturer", "systemVersion", "screenWidth", "screenHeight", "scale", "locale", "timestamp"],
  "additionalProperties": false
}
