{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "UniversalLinkClickRequest — universal-link-click endpoint.",
  "type": "object",
  "properties": {
    "url": { "type": "string" },
    "timestamp": { "type": "integer" },
    "platform": { "type": "string", "enum": ["ios", "android", "unknown"] },
    "link_id": { "type": "string" },
    "params": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "os_version": { "type": ["string", "null"] },
        "app_version": { "type": ["string", "null"] },
        "device_model": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "required": ["url", "timestamp", "platform"],
  "additionalProperties": false
}
